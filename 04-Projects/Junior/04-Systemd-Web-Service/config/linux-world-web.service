[Unit]
Description=Linux World Junior Web Service
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 -m http.server __PORT__ --bind 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DIR__
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target


[Unit]
Description=Linux World loopback lab service
After=network.target

[Service]
Type=simple
User=linux-world-lab
Group=linux-world-lab
WorkingDirectory=/opt/linux-world-lab/app
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

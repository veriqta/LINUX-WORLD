[Unit]
Description=Linux World Toolkit health check example
Documentation=https://example.invalid/linux-world
[Service]
Type=oneshot
User=linux-world-toolkit
Group=linux-world-toolkit
ExecStart=/usr/local/lib/linux-world-toolkit/Health-Checks/Host-Health/check-host-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
